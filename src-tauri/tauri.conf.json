{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Control",
  "version": "0.1.0",
  "identifier": "com.chaski.missioncontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mission Control",
        "width": 1100,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560
      },
      {
        "label": "widget",
        "title": "Mission Control Leaderboard",
        "url": "index.html?window=widget",
        "width": 300,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
