# Mission Control — local environment example.
# Copy to `.env` for a dev fallback API key. `.env` is git-ignored.
#
# Preferred way to set your key: run the app → Settings → paste your key
# (stored in the local SQLite DB). This .env value is only a fallback used
# when no key is saved in Settings.
#
# Get a key: https://console.anthropic.com/settings/keys

VITE_ANTHROPIC_API_KEY=
